process {
    
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        enabled: false
    ]

    withName: DORADO_BASECALLER {
        ext.args = [
            params.dorado_options ? params.dorado_options : ""
        ].join(" ")
        publishDir = [
            path: { "${params.outdir}/basecalling" },
            mode: params.publish_dir_mode,
            enabled: true
        ]
    }
    withName: DORADO_DEMUX {
        ext.args = [
            params.kit ? "--kit-name ${params.kit}" : "",
            params.cram ? "--emit-cram" : ""
        ].join(" ")
        publishDir = [
            path: { "${params.outdir}/demux" },
            mode: params.publish_dir_mode,
            enabled: true
        ]
    }
    withName: MD5SUM_BASECALL{
        publishDir = [
            path: { "${params.outdir}/basecalling/bam_pass" },
            mode: params.publish_dir_mode,
            enabled: true
        ]
    }
    withName: MD5SUM_DEMUX{
        publishDir = [
            path: { "${params.outdir}/demux/bam_pass" },
            mode: params.publish_dir_mode,
            enabled: true
        ]
    }
    withName: MD5SUM_FASTQ{
        publishDir = [
            path: { "${params.outdir}/fastq" },
            mode: params.publish_dir_mode,
            enabled: true
        ]
    } 
    withName: SAMTOOLS_FASTQ {
        ext.args = "-T '*'"
        publishDir = [
            path: { "${params.outdir}/fastq" },
            mode: params.publish_dir_mode,
            enabled: true
        ]
    }
    withName: NANOPLOT {
        publishDir = [
            path: { "${params.outdir}/samples/${meta.sample_id}/nanostat" },
            mode: params.publish_dir_mode,
            enabled: true
        ]
    }
    withName: MULTIQC {
        ext.prefix = "${params.run_name}"
        publishDir = [
            path: { "${params.outdir}/reports" },
            mode: params.publish_dir_mode,
            enabled: true
        ]
    }
 
}
